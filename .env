# CONFIGURACIÓN DE ENTORNO

# Colocar 'true' para usar los datos falsos (Desarrollo UI)
# Colocar 'false' para conectar con la API Real (Integración)
VITE_USE_MOCK=true

# URL del Backend (Spring Boot)
VITE_API_URL=http://localhost:8080/api

# Configuración de Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080/realms/markenx/protocol/openid-connect/token
VITE_KEYCLOAK_CLIENT_ID=markenx-admin